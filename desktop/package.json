{
  "name": "just-sing-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Electron shell for Just Sing!: one window that loads the shared server's URL.",
  "type": "commonjs",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --config electron-builder.config.cjs",
    "build:appimage": "electron-builder --config electron-builder.config.cjs --linux AppImage --x64"
  },
  "devDependencies": {
    "electron": "^44.8.0",
    "electron-builder": "^26.15.3"
  }
}
