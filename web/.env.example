# Copy to .env.local. Leave VITE_AUTH0_CLIENT_ID empty for a guest-only app (no Auth0 code runs).
# These are public identifiers (they ship in the browser bundle), not secrets.
VITE_AUTH0_DOMAIN=your-tenant.us.auth0.com
VITE_AUTH0_CLIENT_ID=
# Must equal the API's AUTH0_AUDIENCE, or Auth0 issues an opaque token the server cannot verify.
VITE_AUTH0_AUDIENCE=https://api.example.com
