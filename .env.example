# Copy to .env and fill in real values. Never commit .env.
GEMINI_API_KEY=your-gemini-api-key-here
DATABASE_URL=postgresql://user:password@localhost:5432/just_sing
AUTH0_DOMAIN=your-tenant.us.auth0.com
AUTH0_AUDIENCE=https://api.example.com

# Set to 1 on public HTTPS so the guest cookie is Secure
COOKIE_SECURE=0
GUEST_TTL_DAYS=7

# Extra browser origins allowed to open WebSockets (comma-separated); same-host is always allowed
ALLOWED_ORIGINS=
RECONNECT_GRACE_SECONDS=60

# Gemini model for coaching blurbs (default gemini-3.5-flash-lite)
GEMINI_MODEL=gemini-3.5-flash-lite

# Folders to load songs from (os.pathsep-separated). Default: api/catalog and ml/data
# SONG_DIRS=

# Set to 1 to load the local spoken-Korean scorer at startup (needs ml/pronunciation/requirements.txt;
# loads wav2vec2 models, ~30 s). Unset: /api/practice answers status "unavailable".
PRONUNCIATION_SCORER=0
